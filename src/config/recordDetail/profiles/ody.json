    "maxTiles": 8,
    "priorityTiles": 4,
    "caption": [
        "{{gather.common.instrument_name}}",
        "orbit {{gather.orbital_missions.orbit}}",
        "{{gather.common.target}}"
    ],
    "shortCaption": [
        "{{gather.common.instrument}}",
        "orbit {{gather.orbital_missions.orbit}}"
