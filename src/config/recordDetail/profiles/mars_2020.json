{
    "match": {
        "mission": "mars_2020"
    },
    "tiles": [
        {
            "path": "gather.landed_missions.planet_day_number",
            "sub": "gather.lighting_geometry.solar_longitude"
        },
        {
            "path": "gather.landed_missions.start_local_true_solar_time",
            "sub": "gather.landed_missions.start_local_mean_solar_time"
        },
        { "path": "gather.landed_missions.rmc_site", "sub": "gather.landed_missions.rmc_drive" },
        { "path": "gather.common.instrument", "sub": "gather.ancillary.color_filter" },
        {
            "path": "gather.landed_missions.site_solar_elevation",
            "sub": "gather.landed_missions.site_solar_azimuth"
        },
        {
            "path": "gather.landed_missions.site_instrument_elevation",
            "sub": "gather.landed_missions.site_instrument_azimuth"
        },
        { "path": "gather.ancillary.eye_type" },
        "gather.time.start_time",
        "gather.pds_archive.bundle_id",
        "gather.common.product_type"
    ],
    "maxTiles": 8,
    "priorityTiles": 4,
    "caption": [
        "{{gather.common.instrument}}",
        "Sol {{gather.landed_missions.planet_day_number}}",
        "{{gather.landed_missions.start_local_true_solar_time}} LTST",
        "Site {{gather.landed_missions.rmc_site}}",
        "Drive {{gather.landed_missions.rmc_drive}}"
    ],
    "shortCaption": [
        "{{gather.common.instrument}}",
        "Sol {{gather.landed_missions.planet_day_number}}"
    ],
    "altText": [
        "{{gather.common.instrument}} image",
        "of the Martian surface on sol {{gather.landed_missions.planet_day_number}}",
        "at site {{gather.landed_missions.rmc_site}}"
    ],
    "emptyState": "no_browse_surface"
}
