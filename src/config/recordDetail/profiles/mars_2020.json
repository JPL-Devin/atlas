{
    "match": {
        "mission": "mars_2020"
    },
    "tiles": [
        {
            "path": "gather.landed_missions.planet_day_number",
            "sub": "gather.lighting_geometry.solar_longitude"
        },
        {
            "path": "gather.landed_missions.start_local_true_solar_time",
            "sub": "gather.landed_missions.start_local_mean_solar_time"
        },
        {
            "path": "gather.landed_missions.rmc_site",
            "sub": "gather.landed_missions.rmc_drive"
        },
        {
            "path": "gather.common.instrument",
            "sub": "gather.ancillary.color_filter"
        },
        {
            "path": "gather.landed_missions.site_solar_elevation",
            "sub": "gather.landed_missions.site_solar_azimuth"
        },
        {
            "path": "gather.landed_missions.site_instrument_elevation",
            "sub": "gather.landed_missions.site_instrument_azimuth"
        },
        {
            "path": "gather.ancillary.eye_type"
        },
        "gather.time.start_time",
        "gather.pds_archive.bundle_id",
        "gather.common.product_type"
    ],
    "maxTiles": 8,
    "priorityTiles": 4,
    "sections": [
        "identification",
        "observation",
        "geometry_surface",
        "files"
    ],
    "separator": ", ",
    "description": [
        "{{gather.common.product_type}} image from the {{gather.common.instrument}} camera aboard {{gather.common.spacecraft}}.",
        "It was taken on sol {{gather.landed_missions.planet_day_number}} at {{gather.landed_missions.start_local_true_solar_time}} local true solar time.",
        "The rover was at site {{gather.landed_missions.rmc_site}}, drive {{gather.landed_missions.rmc_drive}}.",
        "The camera pointed {{gather.landed_missions.site_instrument_azimuth}} azimuth, {{gather.landed_missions.site_instrument_elevation}} elevation.",
        "The product is archived in bundle {{gather.pds_archive.bundle_id}}, release {{gather.pds_archive.release_id}}."
    ],
    "captionTitle": [
        "{{gather.common.instrument}}",
        "Sol {{gather.landed_missions.planet_day_number}}",
        "{{gather.landed_missions.start_local_true_solar_time}} LTST"
    ],
    "captionChips": [
        "Sol {{gather.landed_missions.planet_day_number}}",
        "{{gather.landed_missions.start_local_true_solar_time}} LTST",
        "Site {{gather.landed_missions.rmc_site}}",
        "Drive {{gather.landed_missions.rmc_drive}}",
        "{{gather.common.instrument}}",
        "{{gather.common.product_type}}"
    ],
    "caption": [
        "Imaged by {{gather.common.instrument}} aboard {{gather.common.spacecraft}}",
        "on sol {{gather.landed_missions.planet_day_number}} at {{gather.landed_missions.start_local_true_solar_time}} local true solar time",
        "from site {{gather.landed_missions.rmc_site}} drive {{gather.landed_missions.rmc_drive}}",
        "pointing {{gather.landed_missions.site_instrument_azimuth}} azimuth and {{gather.landed_missions.site_instrument_elevation}} elevation",
        "with the Sun {{gather.landed_missions.site_solar_elevation}} above the horizon at Ls {{gather.lighting_geometry.solar_longitude}}"
    ],
    "shortCaption": [
        "{{gather.common.instrument}}",
        "Sol {{gather.landed_missions.planet_day_number}}"
    ],
    "altText": [
        "{{gather.common.instrument}} image",
        "of the Martian surface on sol {{gather.landed_missions.planet_day_number}}",
        "at site {{gather.landed_missions.rmc_site}}"
    ],
    "emptyState": "no_browse_surface"
}
