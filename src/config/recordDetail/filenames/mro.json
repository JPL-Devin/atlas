            },
            {
                "group": 3,
                "label": "Centre latitude code",
                "color": "teal",
                "description": "Image centre latitude in tenths of a degree, in the same along-orbit convention HiRISE uses.",
                "values": {
                    "4000": "Star observation",
                    "4001": "Phobos observation",
                    "4002": "Deimos observation",
                    "4003": "Special calibration observation"
                },
                "patterns": [
                    {
                        "match": "^0000$",
                        "meaning": "Start of orbit \u2014 the night-side equator"
                    },
                    {
                        "match": "^0900$",
                        "meaning": "90.0\u00b0 along the orbit \u2014 the south pole"
                    },
                    {
                        "match": "^1800$",
                        "meaning": "180.0\u00b0 along the orbit \u2014 the day-side equator"
                    },
                    {
                        "match": "^2700$",
                        "meaning": "270.0\u00b0 along the orbit \u2014 the north pole"
                    },
                    {
                        "match": "^9[0-9]{3}$",
                        "meaning": "Off-planet target ({value}) such as Deimos, Phobos or a star"
                    },
                    {
                        "match": "^0*([0-9]+)([0-9])$",
                        "meaning": "Centred {1}.{2}\u00b0 along the orbit from the night-side equator"
                    }
                ]
            },
            {
                "group": 4,
                "label": "Command mode",
                "color": "violet",
                "description": "How the image was commanded \u2014 the two mechanisms number their images independently.",
                "values": {
                    "I": "Interactive Target List (ITL)",
                    "N": "Non-Interactive File Load (NIFL)"
                }
            },
            {
                "group": 5,
                "label": "Planned latitude",
                "color": "green",
                "description": "Planned centre latitude of the image, in whole degrees.",
                "patterns": [
                    {
                        "match": "^([0-9]{2})$",
                        "meaning": "{number}\u00b0"
                    }
                ]
            },
            {
                "group": 6,
                "label": "Hemisphere",
                "color": "brown",
                "description": "Hemisphere of the planned centre.",
                "values": {
                    "N": "North",
                    "S": "South"
                }
            },
            {
                "group": 7,
                "label": "Planned longitude",
                "color": "amber",
                "description": "Planned centre west longitude of the image, in whole degrees.",
                "patterns": [
                    {
                        "match": "^([0-9]{3})$",
                        "meaning": "{number}\u00b0 west"
                    }
                ]
            },
            {
                "group": 8,
                "label": "Extension",
                "color": "slate",
                "description": "Product format.",
                "values": {
                    "JP2": "JPEG 2000 image",
                    "IMG": "PDS image with an attached label",
                    "LBL": "Detached PDS label"
                }
            }
        ]
    },
    {
        "title": "MRO MARCI EDR filename",
        "reference": "MRO MARCI EDR Products SIS (April 2007), PRODUCT_ID",
        "match": "^(MARCI)-([A-Z0-9]{1,4})-([A-Z])-([0-9]{5})\\.(IMG|LBL)$",
        "segments": [
            {
                "group": 1,
                "label": "Instrument",
                "color": "blue",
                "description": "Mars Color Imager (MARCI), the wide-angle daily global imager.",
                "values": {
                    "MARCI": "Mars Color Imager (MARCI)"
                }
            },
            {
                "group": 2,
                "label": "Mission sub-phase",
                "color": "brown",
                "description": "Mission sub-phase the image belongs to.",
                "patterns": [
                    {
                        "match": "^([A-Z0-9]{1,4})$",
                        "meaning": "Mission sub-phase {value}"
                    }
                ]
            },
            {
                "group": 3,
                "label": "Wavelength",
                "color": "violet",
                "description": "Which of MARCI's five visible and two ultraviolet channels the product carries.",
                "values": {
                    "R": "Red",
                    "G": "Green",
                    "B": "Blue",
                    "O": "Orange",
                    "N": "Near-infrared",
                    "A": "All five visible channels",
                    "C": "RGB colour",
                    "M": "Orange and blue",
                    "U": "Both ultraviolet channels"
                },
                "patterns": [
                    {
                        "match": "^([A-Z])$",
                        "meaning": "Channel combination \"{value}\""
                    }
                ]
            },
            {
                "group": 4,
                "label": "Image number",
                "color": "orange",
                "description": "Image number within the sub-phase.",
                "patterns": [
                    {
                        "match": "^([0-9]{5})$",
                        "meaning": "Image {number}"
                    }
                ]
            },
            {
                "group": 5,
                "label": "Extension",
                "color": "slate",
                "description": "Product format.",
                "values": {
                    "JP2": "JPEG 2000 image",
                    "IMG": "PDS image with an attached label",
                    "LBL": "Detached PDS label"
                }
            }
        ]
    }
