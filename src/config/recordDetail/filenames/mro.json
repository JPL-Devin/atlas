[
    {
        "title": "MRO HiRISE RDR filename",
        "reference": "MRO HiRISE RDR Products SIS (v1.3), \u00a74.4 and \u00a75.7",
        "match": "^([A-Z0-9]{3})_([0-9]{6})_([0-9]{4})_(RED|COLOR|IRB)\\.(JP2|LBL)$",
        "segments": [
            {
                "group": 1,
                "label": "Mission phase",
                "color": "blue",
                "description": "Mission phase the observation belongs to; the first field of the HiRISE observation ID.",
                "values": {
                    "AEB": "Aerobraking phase (only eight HiRISE observations were acquired)",
                    "TRA": "Transition orbit phase",
                    "PSP": "Primary Science Phase",
                    "ESP": "Extended Science Phase \u2014 the archive's label for the extended mission the SIS calls \"Exx\"",
                    "REL": "Relay phase",
                    "INT": "Integration and testing",
                    "CAL": "Calibration observation",
                    "ATL": "ATLO (assembly, test and launch operations) observation",
                    "KSC": "Kennedy Space Center observation",
                    "SVT": "Sequence verification test",
                    "LAU": "Launch",
                    "CRU": "Cruise observation",
                    "APR": "Mars approach observation"
                },
                "patterns": [
                    {
                        "match": "^E([0-9]{2})$",
                        "meaning": "Extended mission phase {1}"
                    },
                    {
                        "match": "^P([0-9]{2})$",
                        "meaning": "CTX mission sub-phase P{1}"
                    },
                    {
                        "match": "^([A-Z][0-9]{2})$",
                        "meaning": "Mission sub-phase {value}"
                    }
                ]
            },
            {
                "group": 2,
                "label": "Orbit",
                "color": "orange",
                "description": "Orbit the observation was acquired on; a chronological sequence number instead for cruise and aerobraking observations.",
                "patterns": [
                    {
                        "match": "^([0-9]{6})$",
                        "meaning": "MRO orbit {number}"
                    }
                ]
            },
            {
                "group": 3,
                "label": "Target code",
                "color": "teal",
                "description": "Latitude of the observation centre expressed as tenths of a degree along the orbit track from the start of orbit \u2014 0000 the night-side equator, 0900 the south pole, 1800 the day-side equator, 2700 the north pole. Values above 3595 are off-planet or special targets.",
                "values": {
                    "4000": "Star observation",
                    "4001": "Phobos observation",
                    "4002": "Deimos observation",
                    "4003": "Special calibration observation"
                },
                "patterns": [
                    {
                        "match": "^0000$",
                        "meaning": "Start of orbit \u2014 the night-side equator"
                    },
                    {
                        "match": "^0900$",
                        "meaning": "90.0\u00b0 along the orbit \u2014 the south pole"
                    },
                    {
                        "match": "^1800$",
                        "meaning": "180.0\u00b0 along the orbit \u2014 the day-side equator"
                    },
                    {
                        "match": "^2700$",
                        "meaning": "270.0\u00b0 along the orbit \u2014 the north pole"
                    },
                    {
                        "match": "^9[0-9]{3}$",
                        "meaning": "Off-planet target ({value}) such as Deimos, Phobos or a star"
                    },
                    {
                        "match": "^0*([0-9]+)([0-9])$",
                        "meaning": "Centred {1}.{2}\u00b0 along the orbit from the night-side equator"
                    }
                ]
            },
            {
                "group": 4,
                "label": "Product type",
                "color": "violet",
                "description": "Which detectors the mosaicked image was built from.",
                "values": {
                    "RED": "Single band built from the red-filter CCDs",
                    "COLOR": "Three-colour image built from the overlapping blue-green, red and near-infrared CCDs",
                    "IRB": "Three-band enhanced colour (near-infrared, red, blue-green)"
                }
            },
            {
                "group": 5,
                "label": "Extension",
                "color": "slate",
                "description": "Product format.",
                "values": {
                    "JP2": "JPEG 2000 image",
                    "IMG": "PDS image with an attached label",
                    "LBL": "Detached PDS label"
                }
            }
        ]
    },
