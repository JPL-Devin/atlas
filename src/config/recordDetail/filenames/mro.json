            },
            {
                "group": 4,
                "label": "Product type",
                "color": "violet",
                "description": "Which detectors the orthorectified image was built from.",
                "values": {
                    "RED": "Single band built from the red-filter CCDs",
                    "COLOR": "Three-colour image built from the overlapping blue-green, red and near-infrared CCDs",
                    "IRB": "Three-band enhanced colour (near-infrared, red, blue-green)"
                }
            },
            {
                "group": 5,
                "label": "Grid spacing",
                "color": "green",
                "description": "Ground sample spacing of the orthorectified grid.",
                "values": {
                    "A": "Grid spacing 0.25 m",
                    "B": "Grid spacing 0.5 m",
                    "C": "Grid spacing 1.0 m",
                    "D": "Grid spacing 2.0 m",
                    "E": "Grid spacing 4.0 m",
                    "F": "Grid spacing 8.0 m",
                    "G": "Grid spacing 16.0 m"
                }
            },
            {
                "group": 6,
                "label": "Sequence",
                "color": "amber",
                "description": "Distinguishes copies of one observation orthorectified to different DTMs; the DTM used is named in the label's SOURCE_PRODUCT_ID.",
                "patterns": [
                    {
                        "match": "^([0-9]{2})$",
                        "meaning": "Orthoimage {number} for this observation"
                    }
                ]
            },
            {
                "group": 7,
                "label": "Extension",
                "color": "slate",
                "description": "Product format.",
                "values": {
                    "JP2": "JPEG 2000 image",
                    "IMG": "PDS image with an attached label",
                    "LBL": "Detached PDS label"
                }
            }
        ]
    },
    {
