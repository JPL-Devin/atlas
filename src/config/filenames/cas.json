[
    {
        "title": "Cassini ISS EDR filename",
        "sis": "cas_iss_edr",
        "reference": "Cassini ISS EDR SIS, \u00a73 (File Naming)",
        "ignoreCase": true,
        "match": "^([NW])([0-9]+)_([0-9]+)\\.(IMG|LBL)$",
        "segments": [
            {
                "group": 1,
                "label": "Instrument",
                "color": "blue",
                "description": "Which ISS camera took the frame.",
                "values": {
                    "N": "Narrow Angle Camera (ISS NAC)",
                    "W": "Wide Angle Camera (ISS WAC)"
                }
            },
            {
                "group": 2,
                "label": "Spacecraft clock",
                "color": "teal",
                "description": "Spacecraft clock value at the time of shutter close.",
                "patterns": [
                    {
                        "match": "^0*([0-9]+)$",
                        "meaning": "Spacecraft clock {1} at shutter close"
                    }
                ]
            },
            {
                "group": 3,
                "label": "Version",
                "color": "amber",
                "description": "Version number of the product; a preliminary product is reissued under this convention once its predicted information is resolved.",
                "patterns": [
                    {
                        "match": "^0*([0-9]+)$",
                        "meaning": "Version {1}"
                    }
                ]
            },
            {
                "group": 4,
                "label": "Extension",
                "color": "slate",
                "description": "Product format.",
                "values": {
                    "IMG": "PDS image file",
                    "LBL": "Detached PDS label"
                }
            }
        ]
    },
    {
        "title": "Cassini ISS preliminary EDR filename",
        "sis": "cas_iss_edr",
        "reference": "Cassini ISS EDR SIS, \u00a73 (File Naming)",
        "ignoreCase": true,
        "match": "^([NW])([0-9]+)\\.([0-9]{3})-([0-9]{2})([0-9]{2})([0-9]{2})\\.(IMG|LBL)$",
        "segments": [
            {
                "group": 1,
                "label": "Instrument",
                "color": "blue",
                "description": "Which ISS camera took the frame.",
                "values": {
                    "N": "Narrow Angle Camera (ISS NAC)",
                    "W": "Wide Angle Camera (ISS WAC)"
                }
            },
            {
                "group": 2,
                "label": "Spacecraft clock",
                "color": "teal",
                "description": "Spacecraft clock value at the time of shutter close.",
                "patterns": [
                    {
                        "match": "^0*([0-9]+)$",
                        "meaning": "Spacecraft clock {1} at shutter close"
                    }
                ]
            },
            {
                "group": 3,
                "label": "Creation day of year",
                "color": "violet",
                "description": "Day of year the preliminary product was created.",
                "patterns": [
                    {
                        "match": "^0*([0-9]+)$",
                        "meaning": "Day of year {1}"
                    }
                ]
            },
            {
                "group": 4,
                "label": "Creation hour",
                "color": "green",
                "description": "Hour of the creation time.",
                "patterns": [
                    {
                        "match": "^([0-9]{2})$",
                        "meaning": "Hour {number}"
                    }
                ]
            },
            {
                "group": 5,
                "label": "Creation minute",
                "color": "orange",
                "description": "Minute of the creation time.",
                "patterns": [
                    {
                        "match": "^([0-9]{2})$",
                        "meaning": "Minute {number}"
                    }
                ]
            },
            {
                "group": 6,
                "label": "Creation second",
                "color": "brown",
                "description": "Second of the creation time.",
                "patterns": [
                    {
                        "match": "^([0-9]{2})$",
                        "meaning": "Second {number}"
                    }
                ]
            },
            {
                "group": 7,
                "label": "Extension",
                "color": "slate",
                "description": "Product format.",
                "values": {
                    "IMG": "PDS image file",
                    "LBL": "Detached PDS label"
                }
            }
        ]
    }
]
